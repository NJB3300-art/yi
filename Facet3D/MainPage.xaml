<Page
    x:Class="Facet3D.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#FF26282C">

    <Page.Resources>
        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="Padding" Value="14,9,14,9"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
        </Style>
        <Style x:Key="HudText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFE6E6E6"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="#F2202124"/>
            <Setter Property="BorderBrush" Value="#FFFF9F1A"/>
            <Setter Property="BorderThickness" Value="0,3,0,0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
    </Page.Resources>

    <Grid x:Name="RootGrid">
        <SwapChainPanel x:Name="Swap"/>

        <!-- Controller cursor -->
        <Canvas x:Name="Overlay" IsHitTestVisible="False">
            <Canvas x:Name="CursorMark">
                <Ellipse Width="26" Height="26" Canvas.Left="-13" Canvas.Top="-13" Stroke="#FFFFFFFF" StrokeThickness="2"/>
                <Ellipse Width="28" Height="28" Canvas.Left="-14" Canvas.Top="-14" Stroke="#66000000" StrokeThickness="1"/>
                <Ellipse Width="6" Height="6" Canvas.Left="-3" Canvas.Top="-3" Fill="#FFFF9F1A"/>
            </Canvas>
        </Canvas>

        <!-- HUD, kept inside the TV title-safe area -->
        <Grid x:Name="Hud" Margin="48,27,48,27" IsHitTestVisible="False">
            <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left" Background="#B0141517" Padding="14,10" CornerRadius="6">
                <TextBlock x:Name="ModeText" Style="{StaticResource HudText}" FontSize="16" FontWeight="SemiBold" Foreground="#FFFF9F1A"/>
                <TextBlock x:Name="ToolText" Style="{StaticResource HudText}"/>
                <TextBlock x:Name="InfoText" Style="{StaticResource HudText}" Foreground="#FFB8BCC4"/>
            </StackPanel>
            <TextBlock x:Name="TitleText" Text="Facet3D" Style="{StaticResource HudText}" FontSize="20" FontWeight="Bold"
                       HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="#80FFFFFF"/>

            <Border x:Name="ToastBox" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top"
                    Background="#E8202124" Padding="18,10" CornerRadius="6" Margin="0,8,0,0" BorderBrush="#FFFF9F1A" BorderThickness="1">
                <TextBlock x:Name="ToastText" Foreground="White" TextWrapping="Wrap" MaxWidth="640" FontSize="15"/>
            </Border>

            <Grid VerticalAlignment="Bottom" Background="#B0141517" Padding="14,8" CornerRadius="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid x:Name="Timeline" Height="20">
                    <Rectangle Fill="#40FFFFFF" Height="4" VerticalAlignment="Center" RadiusX="2" RadiusY="2"/>
                    <Canvas x:Name="KeyCanvas"/>
                    <Rectangle x:Name="Playhead" Width="3" Fill="#FFFF9F1A" HorizontalAlignment="Left"/>
                </Grid>
                <Grid Grid.Row="1" Margin="0,6,0,0">
                    <TextBlock x:Name="FrameText" Style="{StaticResource HudText}"/>
                    <TextBlock x:Name="HintText" Style="{StaticResource HudText}" HorizontalAlignment="Right" Foreground="#FFB8BCC4"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- Menus (built in code; driven by the controller focus engine) -->
        <Grid x:Name="MenuPanel" Visibility="Collapsed" Background="#55000000">
            <Border Style="{StaticResource PanelBorder}" HorizontalAlignment="Left" Width="420" Margin="48,27,0,27">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="MenuTitle" FontSize="24" FontWeight="SemiBold" Margin="2,0,0,10" TextTrimming="CharacterEllipsis"/>
                    <ScrollViewer Grid.Row="1" x:Name="MenuScroll" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="MenuStack" XYFocusKeyboardNavigation="Enabled"/>
                    </ScrollViewer>
                    <TextBlock Grid.Row="2" Text="(A) select    (B) back" Foreground="#FF9AA0A8" Margin="2,10,0,0"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Text input (file names, renaming) -->
        <Grid x:Name="InputPanel" Visibility="Collapsed" Background="#88000000">
            <Border Style="{StaticResource PanelBorder}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="560">
                <StackPanel>
                    <TextBlock x:Name="InputTitle" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBox x:Name="InputBox" FontSize="18" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"/>
                    <TextBlock Text="Press (A) on the box to open the keyboard." Foreground="#FF9AA0A8" Margin="0,8,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button x:Name="InputOk" Content="OK" MinWidth="120" Margin="0,0,8,0" Click="InputOk_Click"/>
                        <Button Content="Cancel" MinWidth="120" Click="InputCancel_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Material editor -->
        <Grid x:Name="MaterialPanel" Visibility="Collapsed" Background="#55000000">
            <Border Style="{StaticResource PanelBorder}" HorizontalAlignment="Left" Width="460" Margin="48,27,0,27">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock x:Name="MatTitle" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,70,0" TextTrimming="CharacterEllipsis"/>
                            <Rectangle x:Name="MatSwatch" Width="56" Height="36" RadiusX="4" RadiusY="4" HorizontalAlignment="Right" Stroke="#80FFFFFF"/>
                        </Grid>
                        <TextBlock Text="Red"/>
                        <Slider x:Name="SliderR" Minimum="0" Maximum="255" StepFrequency="1" ValueChanged="MatSlider_Changed"/>
                        <TextBlock Text="Green"/>
                        <Slider x:Name="SliderG" Minimum="0" Maximum="255" StepFrequency="1" ValueChanged="MatSlider_Changed"/>
                        <TextBlock Text="Blue"/>
                        <Slider x:Name="SliderB" Minimum="0" Maximum="255" StepFrequency="1" ValueChanged="MatSlider_Changed"/>
                        <TextBlock Text="Opacity"/>
                        <Slider x:Name="SliderA" Minimum="0" Maximum="100" StepFrequency="1" ValueChanged="MatSlider_Changed"/>
                        <TextBlock Text="Metallic"/>
                        <Slider x:Name="SliderMetal" Minimum="0" Maximum="100" StepFrequency="1" ValueChanged="MatSlider_Changed"/>
                        <TextBlock Text="Roughness"/>
                        <Slider x:Name="SliderRough" Minimum="0" Maximum="100" StepFrequency="1" ValueChanged="MatSlider_Changed"/>
                        <TextBlock Text="Focus a slider, press (A), move left/right, (B) to release." Foreground="#FF9AA0A8" TextWrapping="Wrap" Margin="0,4,0,8"/>
                        <Button Content="Assign to selection" Style="{StaticResource MenuButton}" Click="MatAssign_Click"/>
                        <Button Content="Rename material" Style="{StaticResource MenuButton}" Click="MatRename_Click"/>
                        <Button x:Name="MatDone" Content="Done" Style="{StaticResource MenuButton}" Click="MatDone_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Controls help -->
        <Grid x:Name="HelpPanel" Visibility="Collapsed" Background="#AA000000">
            <Border Style="{StaticResource PanelBorder}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="900" Margin="48,27">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Facet3D controller guide" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <TextBlock x:Name="HelpText" TextWrapping="Wrap" FontSize="16" LineHeight="24"/>
                        <Button x:Name="HelpClose" Content="Got it" HorizontalAlignment="Right" MinWidth="140" Margin="0,16,0,0" Click="HelpClose_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Busy -->
        <Grid x:Name="BusyPanel" Visibility="Collapsed" Background="#AA000000">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressRing IsActive="True" Width="64" Height="64" Foreground="#FFFF9F1A"/>
                <TextBlock x:Name="BusyText" Margin="0,16,0,0" FontSize="18" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
