<Page
    x:Class="SteamStreamer.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SteamStreamer.Models"
    RequiresPointer="Never">

    <Grid Background="#101820" Padding="48">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="16">
            <TextBlock Text="My Steam Library" FontSize="36" Foreground="White" VerticalAlignment="Center"/>
            <TextBox x:Name="HostBox" PlaceholderText="PC IP address" Width="240"/>
            <Button x:Name="ConnectButton" Content="Connect" Click="ConnectButton_Click"/>
        </StackPanel>

        <GridView x:Name="GameGrid" Grid.Row="1" Margin="0,24,0,0"
                  IsItemClickEnabled="True" ItemClick="GameGrid_ItemClick"
                  UseSystemFocusVisuals="True">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:GameEntry">
                    <Border Width="220" Height="120" Background="#1F2D3A" CornerRadius="6" Padding="12">
                        <TextBlock Text="{x:Bind Title}" Foreground="White" FontSize="20"
                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <TextBlock x:Name="StatusText" Grid.Row="2" Foreground="#9FB3C8" FontSize="16"/>
    </Grid>
</Page>
