diff --git a/App.xaml b/App.xaml
index 15a4efe..2045e2d 100644
--- a/App.xaml
+++ b/App.xaml
@@ -4,6 +4,44 @@
     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
     xmlns:local="using:moonlight_xbox_dx">
     <Application.Resources>
-        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
+        <ResourceDictionary>
+            <ResourceDictionary.MergedDictionaries>
+                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
+            </ResourceDictionary.MergedDictionaries>
+
+            <!-- Blade theme: light glossy backdrop, green accents, framed tiles -->
+            <Color x:Key="BladeAccent">#FF5FAF1F</Color>
+            <Color x:Key="BladeAccentDark">#FF2F6B0F</Color>
+
+            <LinearGradientBrush x:Key="BladeBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
+                <GradientStop Color="#FFF4F6F4" Offset="0" />
+                <GradientStop Color="#FFD7DCD7" Offset="0.55" />
+                <GradientStop Color="#FFB9C2B9" Offset="1" />
+            </LinearGradientBrush>
+
+            <LinearGradientBrush x:Key="BladeGlossBrush" StartPoint="0,0" EndPoint="0,1">
+                <GradientStop Color="#66FFFFFF" Offset="0" />
+                <GradientStop Color="#00FFFFFF" Offset="0.5" />
+            </LinearGradientBrush>
+
+            <SolidColorBrush x:Key="BladeAccentBrush" Color="{StaticResource BladeAccent}" />
+            <SolidColorBrush x:Key="BladeTextBrush" Color="#FF1E2A1E" />
+            <SolidColorBrush x:Key="BladeTileBrush" Color="#FFFFFFFF" />
+
+            <!-- Rounded white tile with a green edge, used around host and app tiles -->
+            <Style x:Key="BladeTileStyle" TargetType="Border">
+                <Setter Property="Background" Value="{StaticResource BladeTileBrush}" />
+                <Setter Property="BorderBrush" Value="{StaticResource BladeAccentBrush}" />
+                <Setter Property="BorderThickness" Value="2" />
+                <Setter Property="CornerRadius" Value="10" />
+                <Setter Property="Padding" Value="12" />
+                <Setter Property="Margin" Value="6" />
+            </Style>
+
+            <Style x:Key="BladeTitleStyle" TargetType="TextBlock">
+                <Setter Property="Foreground" Value="{StaticResource BladeTextBrush}" />
+                <Setter Property="FontWeight" Value="SemiBold" />
+            </Style>
+        </ResourceDictionary>
     </Application.Resources>
 </Application>
